# Copy this file to a location outside the Git repository, replace the two
# values below, then export the variables before starting the server.
NEWSLETTER_SMTP_USER="your-sender@gmail.com"
NEWSLETTER_SMTP_APP_PASSWORD="replace-with-a-gmail-app-password"

# The subscription request is sent here. Change only if the OpenTAI contact
# address changes.
NEWSLETTER_RECIPIENT="danxjma@gmail.com"

# Safe local defaults. For a reverse proxy on the same machine, keep the host
# on 127.0.0.1 and proxy public HTTPS traffic to this port.
OPENTAI_HOST="127.0.0.1"
OPENTAI_PORT="4173"

# Optional comma-separated origins only when the website and API use different
# origins. Same-origin hosting does not need this setting.
NEWSLETTER_ALLOWED_ORIGINS="http://127.0.0.1:4173"

# Five submissions per IP in a fifteen-minute window.
NEWSLETTER_RATE_LIMIT="5"
NEWSLETTER_RATE_WINDOW_SECONDS="900"
NEWSLETTER_MAX_CONCURRENT_DELIVERIES="2"
NEWSLETTER_RATE_MAX_CLIENTS="10000"
OPENTAI_MAX_CONCURRENT_REQUESTS="32"
OPENTAI_REQUEST_TIMEOUT_SECONDS="10"

# Enable only when the Python server is bound to loopback behind a local trusted
# reverse proxy that overwrites X-Real-IP. Directly exposed servers must keep it
# false so clients cannot forge their IP address.
OPENTAI_TRUST_PROXY="false"
